# Скопируйте в .env и заполните, если нужны живые вызовы модели.
# БЕЗ ЭТОГО ФАЙЛА ПРИЛОЖЕНИЕ РАБОТАЕТ: при пустом ключе объяснения и
# заключение берутся из fixtures/llm/, демо-сценарий проходится целиком.

# Ключ OpenAI. Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Модель для объяснений и заключения. По умолчанию gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Порт HTTP-сервера. По умолчанию 3000.
PORT=3000
