# Скопируйте в .env и заполните, если нужны живые вызовы модели.
# Без ключа анализ и заключение рассчитываются локально.
# Сохранённый ответ модели воспроизводится, только если он есть для того же запроса.
# В поставке записаны ответы учебных комплектов. Проверка подключения: npm run check:openai.

# Ключ проекта OpenAI с доступом к начисленным кредитам.
# Получить: https://platform.openai.com/api-keys. Не публикуйте .env или ключ.
OPENAI_API_KEY=

# Модель для проверки сопоставлений. Заключение формируется локально из находок.
OPENAI_MODEL=gpt-4.1-mini
# Смысловой поиск использует отдельную модель; без ключа воспроизводятся записи.
OPENAI_SEMANTIC_MODEL=gpt-4.1

# Порт HTTP-сервера. По умолчанию 3000.
PORT=3000
